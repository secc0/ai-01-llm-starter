# Copy to .env and fill in. Never commit .env.

# Required. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Required. Pick a current model id; free models come and go:
#   llm-starter models --free
MODEL_PRIMARY=your-model-id

# Optional. Comma-separated model ids, tried if the primary fails.
MODEL_FALLBACKS=

# Optional. Defaults to logs/usage.jsonl
# LLM_LOG_PATH=logs/usage.jsonl
